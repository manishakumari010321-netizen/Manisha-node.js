10. ES6 Student Management System (Combined ES6 Concepts)
JavaScript
const students = [
    { id: 1, name: "Rahul", marks: 85 },
    { id: 2, name: "Priya", marks: 92 },
    { id: 3, name: "Amit", marks: 70 }
];

const topper = students.find(student => student.marks > 90);

const averageMarks =
    students.reduce((sum, student) => sum + student.marks, 0) /
    students.length;

const passedStudents =
    students.filter(student => student.marks >= 75);

console.log("Topper:", topper);
console.log("Average Marks:", averageMarks);
console.log("Passed Students:", passedStudents);
